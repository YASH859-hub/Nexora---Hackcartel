# =============================================================================
# Nexora — environment template (copy to .env.local for local dev)
# =============================================================================
# Vercel: set VITE_* variables in the project dashboard (never commit secrets).
# Render: set Twilio + FRONTEND_URL in the backend service (no VITE_* Twilio keys).
# =============================================================================

# --- Frontend (Vercel) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_GEMINI_API_KEY=your_gemini_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_GOOGLE_API_KEY=your_google_api_key
VITE_GOOGLE_CALENDAR_API_KEY=your_calendar_api_key
VITE_DEEPSEEK_API_KEY=your_deepseek_key
VITE_DEEPSEEK_MODEL=deepseek-chat

# Render backend URL (required in production on Vercel)
# Example: https://nexora-backend.onrender.com
VITE_BACKEND_URL=http://localhost:5000

# --- Backend (Render) — also used locally when running `cd backend && npm run dev` ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Your Vercel production URL (CORS), e.g. https://nexora-hackcartel.vercel.app
FRONTEND_URL=http://localhost:3000
# Optional extra origins (comma-separated)
ALLOWED_ORIGINS=

PORT=5000
NODE_ENV=development
WHATSAPP_BRAND_NAME=Nexora

# Briefings (optional)
BRIEFING_SEND_ON_STARTUP=true
BRIEFING_STARTUP_DELAY_MS=2500
BRIEFING_TZ=
BRIEFING_DATA_DIR=

# Ollama (optional; set on Render if you host Ollama elsewhere)
OLLAMA_BASE_URL=http://127.0.0.1:11434
